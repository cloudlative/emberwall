{
  "name": "emberwall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Visual, version-aware firewall builder for iptables, nftables, ufw and firewalld",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudlative/emberwall.git"
  },
  "homepage": "https://github.com/cloudlative/emberwall#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "vite-node cli/emberwall.ts --",
    "build:cli": "esbuild cli/emberwall.ts --bundle --platform=node --format=esm --outfile=dist-cli/emberwall.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "lucide-react": "^1.72.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
